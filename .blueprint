    - app/Models/User.php
    - app/Models/Supplier.php
    - app/Models/Product.php
    - app/Models/ProductUnit.php
    - app/Models/InventoryBatch.php
    - app/Models/CustomerType.php
    - app/Models/Customer.php
    - app/Models/Sale.php
    - app/Models/SaleItem.php
